nextflow_pipeline {

    name "READS_DATAFLOW (stub)"
    script "../tests/reads_dataflow.nf"
    tag "stub"
    options "-stub"

    test("the reads data-channel pipeline wires select -> assemble -> gather -> derep -> phylo -> tree2tax") {
        when {
            params {
                outdir = "$outputDir"
                mode = 'reads'
                reads_args = '-tg francisella --platform illumina --max-runs 5'
                derep_process_size = 1
                derep_tool = 'sourmash'
            }
        }
        then {
            assert workflow.success
            assert path("$outputDir/tree2tax.tsv").exists()
            assert path("$outputDir/genomes_map.tsv").exists()
            assert path("$outputDir/phylo/tree/tree.nwk").exists()
            assert path("$outputDir/reads/reads.tsv").exists()
            assert path("$outputDir/reads/selection.tsv").exists()
            assert path("$outputDir/reads/assembly_stats.tsv").exists()
            assert path("$outputDir/reads/excused_runs.tsv").exists()
            assert path("$outputDir/pipeline_info/software_versions.yml").text.contains("repgenr")
            def names = workflow.trace.succeeded().collect { t -> t.name }
            assert names.any { n -> n.contains('READS_SELECT (francisella)') }
            assert names.count { n -> n.contains('READS_ASSEMBLE (francisella.SRR') } == 3
            assert names.any { n -> n.contains('READS_GATHER (francisella)') }
            assert names.any { n -> n.contains('DEREP_MERGE (francisella.merged)') }
            assert names.any { n -> n.contains('TREE2TAX (francisella)') }
        }
    }

    test("with reads_screen only the runs of passed.txt are assembled") {
        when {
            params {
                outdir = "$outputDir"
                mode = 'reads'
                reads_args = '-tg francisella --platform illumina --max-runs 5'
                reads_screen = true
                reads_sketch_spots = 5000
                gtdb_sketch = '/db/gtdb.sig.zip'
                gtdb_lineages = '/db/lineages.csv'
                derep_process_size = 1
                derep_tool = 'sourmash'
            }
        }
        then {
            assert workflow.success
            def names = workflow.trace.succeeded().collect { t -> t.name }
            assert names.any { n -> n.contains('READS_SKETCH (francisella)') }
            assert names.any { n -> n.contains('READS_SCREEN (francisella)') }
            // The stub screen excuses the second run of reads.tsv as a duplicate.
            assert names.count { n -> n.contains('READS_ASSEMBLE (francisella.SRR') } == 2
            assert !names.any { n -> n.contains('READS_ASSEMBLE (francisella.SRR000002)') }
            assert path("$outputDir/reads/reads_sketches/spots_5000/reads_sketches.tsv").exists()
            assert path("$outputDir/reads/reads_screen/spots_5000/reads_screen.tsv").exists()
            assert path("$outputDir/reads/reads_screen/spots_5000/passed.txt").exists()
            assert path("$outputDir/tree2tax.tsv").exists()
        }
    }

    test("a screen that passes no run stops the pipeline with its reason") {
        when {
            params {
                outdir = "$outputDir"
                mode = 'reads'
                reads_args = '-tg francisella --platform illumina --max-runs 5'
                reads_screen = true
                reads_screen_args = '--min-fraction 0.9'
                gtdb_sketch = '/db/gtdb.sig.zip'
                gtdb_lineages = '/db/lineages.csv'
                derep_process_size = 1
                derep_tool = 'sourmash'
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('passed no run') } ||
                workflow.stderr.any { line -> line.contains('passed no run') }
            def names = workflow.trace.succeeded().collect { t -> t.name }
            assert !names.any { n -> n.contains('READS_ASSEMBLE') }
        }
    }

    test("reads_screen without the GTDB sketch is refused before any task") {
        when {
            params {
                outdir = "$outputDir"
                mode = 'reads'
                reads_screen = true
            }
        }
        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains('--reads_screen needs --gtdb_sketch') } ||
                workflow.stderr.any { line -> line.contains('--reads_screen needs --gtdb_sketch') }
        }
    }

    test("with reads_sketch alone the runs are sketched and every run is assembled") {
        when {
            params {
                outdir = "$outputDir"
                mode = 'reads'
                reads_args = '-tg francisella --platform illumina --max-runs 5'
                reads_sketch = true
                derep_process_size = 1
                derep_tool = 'sourmash'
            }
        }
        then {
            assert workflow.success
            def names = workflow.trace.succeeded().collect { t -> t.name }
            assert names.any { n -> n.contains('READS_SKETCH (francisella)') }
            assert !names.any { n -> n.contains('READS_SCREEN') }
            assert names.count { n -> n.contains('READS_ASSEMBLE (francisella.SRR') } == 3
            assert path("$outputDir/reads/reads_sketches/all/reads_sketches.tsv").exists()
        }
    }

    test("with --msa-source coregene the assembled representatives are annotated and staged") {
        config "./annotate_debug.config"
        when {
            params {
                outdir = "$outputDir"
                mode = 'reads'
                reads_args = '-tg francisella --platform illumina --max-runs 5'
                derep_process_size = 1
                derep_tool = 'sourmash'
                phylo_args = '--msa-source coregene --treebuilder iqtree'
            }
        }
        then {
            assert workflow.success
            def names = workflow.trace.succeeded().collect { t -> t.name }
            def annotated = names.count { n -> n.contains('ANNOTATE_SCATTER:ANNOTATE') }
            assert annotated >= 1
            assert workflow.stdout.any { line -> line.contains("annotations: staged (${annotated} records)") }
        }
    }
}
