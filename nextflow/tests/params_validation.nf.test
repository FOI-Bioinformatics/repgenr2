nextflow_pipeline {

    name "Parameter validation (nf-schema)"
    script "../main.nf"
    tag "stub"

    test("an unknown mode fails validation before any stage runs") {
        when {
            params {
                mode = 'fungal'
            }
        }
        then {
            assert !workflow.success
            assert workflow.stdout.join('\n').contains('mode') ||
                   workflow.stderr.join('\n').contains('mode')
        }
    }

    test("phylo_split_msa with an alignment-free builder fails before any stage runs") {
        when {
            params {
                phylo_split_msa = true
                phylo_args = '--treebuilder mashtree'
            }
        }
        then {
            assert !workflow.success
            assert workflow.stdout.join('\n').contains('phylo_split_msa') ||
                   workflow.stderr.join('\n').contains('phylo_split_msa')
        }
    }

    test("a third-party dereplicator name passes schema validation") {
        // The enum was dropped so pip-installed plugins are usable from
        // Nextflow; RepGenR2's own registry validation rejects unknown names
        // at stage start instead. With --help the pipeline exits before any
        // stage runs, proving the schema no longer blocks the name.
        when {
            params {
                derep_tool = 'thirdpartytool'
                help = true
            }
        }
        then {
            assert workflow.success
        }
    }
}
