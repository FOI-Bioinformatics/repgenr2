nextflow_process {

    name "READS_SKETCH (stub)"
    script "../modules/local/dataflow/reads_sketch.nf"
    tag "stub"
    process "READS_SKETCH"
    options "-stub"
    config "./reads_debug.config"

    test("sketches the runs of its chunk into the variant of the cap") {
        when {
            params {
                reads_sketch_spots = 5000
            }
            process {
                """
                input[0] = tuple([id: 'test.1', mode: 'reads'], file("${projectDir}/nextflow/tests/data/reads.tsv"), ['SRR000001', 'SRR000002'])
                """
            }
        }
        then {
            assert process.success
            with(process.out.sketches.get(0)) {
                assert get(0).id == 'test.1'
                def dir = file(get(1))
                assert dir.name == 'sketches'
                assert file("${dir}/spots_5000/reads_sketches.tsv").exists()
                assert file("${dir}/spots_5000/SRR000001.sig.zip").exists()
                assert !file("${dir}/spots_5000/SRR000003.sig.zip").exists()
                def lines = file("${dir}/spots_5000/reads_sketches.tsv").text.split('\n')
                assert lines.size() == 3
                assert lines[1].startsWith('SRR000001\tok\t5000')
            }
            assert process.stdout.any { line -> line.contains('ext.args: --max-spots 5000') }
        }
    }

    test("without a cap, and without a chunk list, every run goes to the all variant") {
        when {
            process {
                """
                input[0] = tuple([id: 'test.1', mode: 'reads'], file("${projectDir}/nextflow/tests/data/reads.tsv"), [])
                """
            }
        }
        then {
            assert process.success
            def index = file("${file(process.out.sketches.get(0).get(1))}/all/reads_sketches.tsv")
            assert index.exists()
            assert index.text.split('\n').size() == 4
        }
    }
}
