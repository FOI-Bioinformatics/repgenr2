nextflow_process {

    name "PHYLO (stub)"
    script "../modules/local/dataflow/phylo.nf"
    tag "stub"
    process "PHYLO"
    options "-stub"
    config "./annotate_debug.config"

    test("emits a Newick tree naming every representative") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'test', mode: 'bacterial'],
                    file("${projectDir}/nextflow/tests/data/derep_out"),
                    [ file("${projectDir}/nextflow/tests/data/outgroup/Fam_Out_grp_GCF_000009.1.fasta") ],
                    file("${projectDir}/nextflow/tests/data/outgroup_accession.txt"),
                    []
                )
                input[1] = []
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
            with(process.out.tree.get(0)) {
                assert get(0).id == 'test'
                def newick = path(get(1)).text.trim()
                assert newick.endsWith(';')
                assert newick.contains('Fam_Gen_sp1_GCF_000001.1')
                assert newick.contains('Fam_Gen_sp2_GCF_000002.1')
            }
        }
    }

    test("stages the annotation records it is given, and none otherwise") {
        when {
            process {
                """
                input[0] = tuple(
                    [id: 'test', mode: 'bacterial'],
                    file("${projectDir}/nextflow/tests/data/derep_out"),
                    [ file("${projectDir}/nextflow/tests/data/outgroup/Fam_Out_grp_GCF_000009.1.fasta") ],
                    file("${projectDir}/nextflow/tests/data/outgroup_accession.txt"),
                    [
                        file("${projectDir}/nextflow/tests/data/annotations/Fam_Gen_sp1_GCF_000001.1"),
                        file("${projectDir}/nextflow/tests/data/annotations/Fam_Gen_sp2_GCF_000002.1")
                    ]
                )
                input[1] = []
                """
            }
        }
        then {
            assert process.success
            assert process.stdout.any { line -> line.contains('annotations: staged (2 records)') }
        }
    }
}
