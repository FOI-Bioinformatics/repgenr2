nextflow_workflow {

    name "DEREPLICATE_SCATTER (stub)"
    script "../subworkflows/local/dereplicate_scatter.nf"
    tag "stub"
    workflow "DEREPLICATE_SCATTER"
    options "-stub"

    test("scatters chunks and gathers one merged representative set") {
        when {
            params {
                derep_process_size = 2
                derep_tool = 'sourmash'
            }
            workflow {
                """
                input[0] = channel.fromPath("${projectDir}/nextflow/tests/data/genomes/*.fasta")
                    .collect()
                    .map { files -> tuple([id: 'test', mode: 'bacterial'], files) }
                input[1] = channel.value(tuple([id: 'test', mode: 'bacterial'], []))
                input[2] = channel.value(tuple([id: 'test', mode: 'bacterial'], []))
                """
            }
        }
        then {
            assert workflow.success
            // exactly one merged result, carrying the run meta again
            assert workflow.out.reps.size() == 1
            with(workflow.out.reps.get(0)) {
                assert get(0) == [id: 'test', mode: 'bacterial']
                def dir = get(1)
                assert path("${dir}/clusters.tsv").exists()
                assert path("${dir}/representatives").exists()
            }
            assert workflow.out.versions
        }
    }

    test("refines the merged result when seeds are given") {
        when {
            params {
                derep_process_size = 2
                derep_tool = 'sourmash'
                derep_refine = 'GCA_000001.1,GCA_000003.1'
                derep_refine_ani = 0.999
            }
            workflow {
                """
                input[0] = channel.fromPath("${projectDir}/nextflow/tests/data/genomes/*.fasta")
                    .collect()
                    .map { files -> tuple([id: 'test', mode: 'bacterial'], files) }
                input[1] = channel.value(tuple([id: 'test', mode: 'bacterial'], []))
                input[2] = channel.value(tuple([id: 'test', mode: 'bacterial'], []))
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.reps.size() == 1
            with(workflow.out.reps.get(0)) {
                assert get(0) == [id: 'test', mode: 'bacterial']
                def dir = get(1)
                // the emitted result is the refinement's
                assert path("${dir}/refined.tsv").exists()
                assert path("${dir}/clusters.tsv").exists()
            }
        }
    }
}
