// RepGenR2 Nextflow configuration.

plugins {
    // Parameter validation and schema-driven help/summary (nf-core convention).
    id 'nf-schema@2.6.1'
}

params {
    // Where execution reports and published results are written.
    outdir = 'results'

    // Pipeline: 'bacterial' (GTDB), 'viral' (NCBI Virus / BV-BRC) or 'reads'
    // (ENA/SRA sequencing runs, assembled per run).
    mode = 'bacterial'

    // Top-level options prepended to every repgenr call (set by container
    // profiles below to run external tools in containers).
    repgenr_opts = ''

    // Per-stage argument strings passed through to the repgenr CLI. The thread
    // count is injected from the task's reserved CPUs, so it is not set here.
    metadata_args  = '-r 232.0 --gtdb-version bac120 -d rep -l genus -tg francisella'
    vmetadata_args = '--target adenoviridae'
    vgenome_args   = '-tg mastadenovirus'
    // Alignment-free tree builder by default: it scales to large sets, whereas
    // the whole-genome aligners (progressivemauve aligns each genome against
    // one reference; cactus builds a pangenome graph) only suit small, closely
    // related sets. Set phylo_args to '--aligner ...' for those.
    phylo_args     = '--treebuilder mashtree'
    // Run the alignment and the tree as separate tasks. Off by default (one
    // task, as before); on, the alignment survives a change of tree builder
    // or bootstrap, and the two halves ask for their own resources. Only for
    // tree builders that consume an alignment, not for mashtree or sourmash.
    phylo_split_msa = false
    // Bacterial path: sketch every genome and the outgroup with sourmash
    // (k=21/31/51, scaled=1000), publish them as sketches/, and stage them
    // into the dereplication and tree tasks, where a sourmash dereplicator or
    // tree builder reads them instead of sketching. Needs sourmash; off by
    // default so a run without sourmash is unaffected.
    sketch         = false
    // Core-gene route (phylo_args with --msa-source coregene): ANNOTATE
    // annotates every representative and the outgroup in its own task, with
    // this annotator (bakta or prokka) and these annotate-build arguments.
    // bakta needs its database: give the directory here, or set BAKTA_DB in
    // the task environment.
    annotator      = 'bakta'
    bakta_db       = null
    annotate_args  = ''
    tree2tax_args  = ''

    // Reads mode: the ENA/SRA selection (repgenr reads), the assembler for
    // every run ('auto' picks by platform), extra assemble-run flags, and the
    // optional databases that switch on quality scoring (CheckM2) and
    // organism verification (sourmash gather against a GTDB sketch).
    reads_args     = '-tg francisella --platform illumina --max-runs 5'
    assembler      = 'auto'
    assemble_args  = ''
    checkm2_db     = null
    gtdb_sketch    = null
    gtdb_lineages  = null
    // Reads sketch and screen before any download: reads_sketch streams each
    // selected run from the archive into a sourmash sketch (READS_SKETCH,
    // reads_sketch_spots caps the spots per run); reads_screen judges the
    // sketches against the GTDB sketch (READS_SCREEN; needs gtdb_sketch and
    // gtdb_lineages) and assembles only the runs that pass. Extra
    // reads-screen flags (--min-fraction, --dup-ani) go in reads_screen_args.
    reads_sketch       = false
    reads_sketch_spots = null
    reads_screen       = false
    reads_screen_args  = ''

    // Scatter-gather dereplication. Leave derep_process_size null for a single
    // chunk; set it to scatter large sets across tasks (e.g. 2000). The tool and
    // ANI thresholds are used by each chunk and the merge.
    derep_process_size     = null
    derep_tool             = 'skder'
    derep_primary_ani      = 0.90
    derep_secondary_ani    = 0.99
    derep_aligned_fraction = 0.50
    // Representative choice in the chunk and merge steps: pick by the CheckM
    // quality in selection.tsv and the genome N50 (completeness -
    // 5 x contamination + 0.5 x log10(N50)), or 'tool' to keep the adapter's
    // own pick. Only applies when a selection.tsv
    // reaches the dereplication steps (mapped to their ext.args in
    // conf/modules.config).
    derep_keeper           = 'quality'
    // Merge-step representative selection, as on the `dereplicate` command:
    // collapse to one representative per taxon after the merge (none |
    // species | genus; taxonomy from selection.tsv or the filenames), and
    // search the merge pass's secondary ANI to land near a representative
    // count (0 = off).
    derep_reduce           = 'none'
    derep_target_reps      = 0
    // Finer resolution inside a lineage after the merge (dereplicate-refine):
    // seed genomes (comma-separated filenames, stems or accessions) at
    // derep_refine_ani, and/or a TSV of seed and ani for several lineages.
    derep_refine           = null
    derep_refine_ani       = null
    derep_refine_file      = null

    // Print a usage message and exit (handled in main.nf before validation).
    help = false
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
        // The local executor refuses a task that asks for more than the
        // machine has (base.config requests up to 32 CPUs and 128 GB for the
        // heavy processes), so cap requests to this host. Cluster and cloud
        // profiles stay uncapped; a site config can override either value.
        process.resourceLimits = [
            cpus: Runtime.runtime.availableProcessors(),
            memory: "${(java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize / (1024L * 1024 * 1024)) as long}.GB",
        ]
    }

    // A cluster profile sets only the executor: the queue, account and any
    // cloud settings (region, job queue, an image that provides repgenr) are
    // site-specific and belong in a site config passed with `-c`.
    slurm {
        process.executor = 'slurm'
    }

    // Container profiles: RepGenR2 runs each external tool in a container.
    // (RepGenR2 itself must be available to the process; on HPC the Singularity
    // engine is the clean target. Stacking with Nextflow's own docker engine
    // implies docker-in-docker, so these drive RepGenR2's adapter-level backend.)
    docker {
        params.repgenr_opts = '--container docker'
    }

    singularity {
        params.repgenr_opts = '--container singularity'
    }

    wave {
        // RepGenR2 resolves multi-tool/arm64 images via the Wave CLI.
        params.repgenr_opts = '--container singularity --wave'
    }

    test {
        // Minimal resources for a quick local smoke run on a small target.
        process.executor = 'local'
        process.resourceLimits = [ cpus: 2, memory: '4.GB', time: '1.h' ]
        params.metadata_args = '-r 232.0 --gtdb-version bac120 -d rep -l genus -tg francisella --limit 5'
        params.derep_tool = 'sourmash'
        params.phylo_args = '--treebuilder mashtree'
    }
}

// Execution reports for every run (nf-core convention). Written under
// outdir/pipeline_info with a per-run timestamp so reruns do not overwrite.
// The timestamp is inlined (not a `def`) because the strict config parser
// disallows variable declarations alongside config statements.
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}

manifest {
    name            = 'repgenr2'
    author          = 'Andreas Sjodin'
    homePage        = 'https://github.com/FOI-Bioinformatics/repgenr2'
    description     = 'Representative-Genome Repositories pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '2.1.0'
    license         = 'MIT'
}
