// Per-process tool arguments and publishing (nf-core modules.config convention).
//
// Modules read only task.ext.*; the user-facing parameters are mapped here, so a
// site can retune one process from its own config (-c site.config) with a
// withName block, without editing the modules or the parameter schema.

process {
    // Top-level repgenr options (container backend) for every repgenr call.
    ext.repgenr_opts = { params.repgenr_opts }

    withName: 'METADATA' {
        ext.args = { params.metadata_args }
        publishDir = [
            path: { "${params.outdir}/metadata" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: 'READS_SELECT' {
        ext.args = { params.reads_args }
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: 'READS_ASSEMBLE' {
        // The reads screen (--screen-reads in assemble_args) reads the GTDB
        // sketch and lineages the GENOME_QC classifier also uses.
        ext.args = {
            def screen = (params.assemble_args ?: '').contains('--screen-reads')
            [
                params.assembler && params.assembler != 'auto' ? "--assembler ${params.assembler}" : '',
                screen && params.gtdb_sketch ? "--gtdb-sketch ${params.gtdb_sketch}" : '',
                screen && params.gtdb_lineages ? "--gtdb-lineages ${params.gtdb_lineages}" : '',
                params.assemble_args ?: '',
            ].findAll { arg -> arg }.join(' ').trim()
        }
        // The run's platform, read by the process_assembly memory rule.
        ext.platform = { meta.platform }
    }

    withName: 'GENOME_QC' {
        ext.args = {
            [
                params.checkm2_db ? "--checkm2-db ${params.checkm2_db}" : '',
                params.gtdb_sketch ? "--gtdb-sketch ${params.gtdb_sketch}" : '',
                params.gtdb_lineages ? "--gtdb-lineages ${params.gtdb_lineages}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: 'READS_GATHER' {
        // The quality gate (--min-completeness, --max-contamination) keeps the
        // step's defaults; a site config can retune it here.
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/reads" },
            mode: 'copy',
            pattern: 'out/*.{tsv,txt}',
            saveAs: { filename -> filename.replaceFirst('^out/', '') },
        ]
    }

    withName: 'VACQUIRE' {
        ext.args  = { params.vmetadata_args }
        ext.args2 = { params.vgenome_args }
    }

    withName: 'DEREP_CHUNK|DEREP_MERGE' {
        ext.args = {
            [
                "--tool ${params.derep_tool}",
                "--primary-ani ${params.derep_primary_ani}",
                "--secondary-ani ${params.derep_secondary_ani}",
                "--aligned-fraction ${params.derep_aligned_fraction}",
                "--keeper ${params.derep_keeper}",
                params.mode == 'viral' ? '--virus' : '',
            ].join(' ').trim()
        }
    }

    withName: 'DEREP_MERGE' {
        // Merge-only representative selection (the chunks never reduce or
        // search): appended after the shared derep args.
        ext.args2 = {
            [
                params.derep_reduce && params.derep_reduce != 'none' ? "--reduce ${params.derep_reduce}" : '',
                (params.derep_target_reps as Integer) > 0 ? "--target-reps ${params.derep_target_reps}" : '',
            ].join(' ').trim()
        }
        // Stable published directory name regardless of the run meta id.
        ext.prefix = 'merged'
        publishDir = [
            path: { "${params.outdir}/dereplicate" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    // Genome sketches (sourmash, k=21/31/51, scaled=1000), published beside
    // the other results under the same sketches/ name as in a workdir.
    withName: 'SKETCH' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    // One genome per task for the core-gene route, published under the same
    // annotations/ name as in a workdir (without its index, which the phylo
    // task writes for itself).
    withName: 'ANNOTATE' {
        ext.args = { "--tool ${params.annotator} ${params.annotate_args}".trim() }
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: 'PHYLO' {
        ext.args = { params.phylo_args }
        ext.annotator = { params.annotator }
        publishDir = [
            path: { "${params.outdir}/phylo" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    // The two halves of PHYLO when params.phylo_split_msa is set. Both read
    // the same phylo_args: the alignment half ignores the tree builder's
    // flags and the tree half ignores the aligner's.
    withName: 'PHYLO_MSA' {
        ext.args = { params.phylo_args }
        ext.annotator = { params.annotator }
        publishDir = [
            path: { "${params.outdir}/phylo" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    withName: 'PHYLO_TREE' {
        ext.args = { params.phylo_args }
        publishDir = [
            path: { "${params.outdir}/phylo" },
            mode: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename },
        ]
    }

    // A tree built with --no-outgroup in phylo_args has no outgroup leaf, while
    // the acquire step still stages the outgroup; pass --no-outgroup on so
    // tree2tax-relations leaves the tree unrooted instead of failing. A tree
    // that phylo rooted at the midpoint (--root midpoint) keeps that root:
    // pass --keep-root on so tree2tax-relations does not reroot on the outgroup.
    withName: 'TREE2TAX' {
        ext.args = {
            def t2t = (params.tree2tax_args ?: '').toString()
            def t2tTokens = t2t.tokenize()
            def phyloTokens = (params.phylo_args ?: '').toString().tokenize()
            def unrooted = phyloTokens.contains('--no-outgroup')
            def rootAt = phyloTokens.indexOf('--root')
            def midpoint = phyloTokens.contains('--root=midpoint') ||
                (rootAt >= 0 && rootAt + 1 < phyloTokens.size() && phyloTokens[rootAt + 1] == 'midpoint')
            def extra = []
            if (unrooted && !t2tTokens.contains('--no-outgroup')) { extra << '--no-outgroup' }
            if (midpoint && !t2tTokens.contains('--keep-root')) { extra << '--keep-root' }
            ([t2t] + extra).join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy',
            pattern: '*.tsv',
        ]
    }
}
